{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
    "name": "Articulo API - CRUD (proyecto_final_2026)",
    "description": "Colección para consumir el CRUD de artículos expuesto por ArticuloController en proyecto_final_2026 (Spring Boot).\n\nBase URL por defecto: http://localhost:8080 (sin context-path, sin server.port configurado en application.properties).\n\nEndpoints:\n- GET    /api/articulos        -> listar todos\n- GET    /api/articulos/{id}   -> obtener por id\n- POST   /api/articulos        -> crear\n- PUT    /api/articulos/{id}   -> actualizar\n- DELETE /api/articulos/{id}   -> eliminar",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "articuloId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Listar artículos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/articulos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "articulos"]
        },
        "description": "Obtiene el listado completo de artículos."
      },
      "response": []
    },
    {
      "name": "Obtener artículo por ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/articulos/{{articuloId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "articulos", "{{articuloId}}"]
        },
        "description": "Obtiene un artículo por su ID. Devuelve 404 si no existe."
      },
      "response": []
    },
    {
      "name": "Crear artículo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Teclado mecánico\",\n  \"precio\": 15999.99\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/articulos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "articulos"]
        },
        "description": "Crea un nuevo artículo. El campo 'id' es autogenerado, no es necesario enviarlo."
      },
      "response": []
    },
    {
      "name": "Actualizar artículo",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Teclado mecánico RGB\",\n  \"precio\": 18999.99\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/articulos/{{articuloId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "articulos", "{{articuloId}}"]
        },
        "description": "Actualiza los datos de un artículo existente según su ID."
      },
      "response": []
    },
    {
      "name": "Eliminar artículo",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/articulos/{{articuloId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "articulos", "{{articuloId}}"]
        },
        "description": "Elimina un artículo por su ID. Devuelve 204 si se eliminó, 404 si no existe."
